# ==============================================================================
# HS ESTATE — Environment Configuration Example
# ==============================================================================

# 1. Google Gemini AI API Configuration
# Used strictly on the server-side proxy routes (/api/ai/*). NEVER exposed to the client.
# Configured automatically in Google AI Studio runtime or provided in .env
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Supabase PostgreSQL & Authentication (Optional for persistent cloud backend)
# When omitted, HS ESTATE runs smoothly in local verified demonstration mode.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Server-side Service Role Key (Used ONLY by server.ts, NEVER sent to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 3. Server Runtime & Network
PORT=3000
NODE_ENV="development"
APP_URL="MY_APP_URL"
